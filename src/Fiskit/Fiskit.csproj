<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Fiskit</RootNamespace>
    <PackageId>Fiskit</PackageId>
    <Version>0.1.1</Version>
    <Authors>FisKit</Authors>
    <Description>Official .NET client for the FisKit API: Argentine electronic invoices with ARCA (ex AFIP) in a single request.</Description>
    <PackageTags>arca;afip;factura-electronica;invoicing;argentina;cae;fiskit</PackageTags>
    <PackageProjectUrl>https://fiskit.com.ar/developers</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fiskitapp/fiskit-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

</Project>
